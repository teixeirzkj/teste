# Copie para .env.local (uso local) ou cadastre na Vercel (Settings → Environment Variables).
# Nunca faça commit do .env.local.

# Banco Postgres do Supabase — use a URL do "Transaction pooler" (porta 6543).
# Supabase → Project Settings → Database → Connection string → Transaction pooler.
# Sem esta variável, o site usa um Postgres embutido local (pasta ./data) — só para desenvolvimento.
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Segredo das sessões do painel (mínimo 32 caracteres aleatórios).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Primeiro acesso ao painel (usado só na primeira inicialização do banco)
ADMIN_EMAIL=admin@pizzariasaopaulo.com.br
ADMIN_PASSWORD=troque-esta-senha

# Endereço público do site (prévias de link no WhatsApp/Instagram)
SITE_URL=https://pizzaria-sao-paulo.vercel.app

# "false" para iniciar sem os pedidos de demonstração
SEED_DEMO_ORDERS=true
